# Application
APP_NAME=AgentFramework
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# LLM (OpenAI or Anthropic Claude)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=your-anthropic-key
LLM_MODEL=gpt-4o-mini
CODING_MODEL=gpt-4o-mini
CODE_REVIEW_MODEL=composer-2.5
# 9Router default when generic model names (composer-2.5, gpt-*) are remapped
# NINEROUTER_CURSOR_MODEL=cu/claude-4.5-sonnet
PM_MODEL=gpt-4o
PRD_TEMPLATE_PATH=docs/templates/PRD_TEMPLATE.md

# QA Agent (Branch QA — docs/QA_AGENT_GUIDE.md)
QA_ACCEPTANCE_CRITERIA_TEMPLATE_PATH=docs/templates/qa/ACCEPTANCE_CRITERIA_TEMPLATE.md
QA_FEATURE_BRIEF_TEMPLATE_PATH=docs/templates/qa/FEATURE_BRIEF_TEMPLATE.md
QA_LANGUAGE=fa
QA_EXPORT_DIR=data/qa_exports
QA_GATE_ENABLED=true
QA_GATE_ALLOWED_VERDICTS=PASS,PASS_WITH_GAPS
QA_EXPORT_COMMIT_TO_BRANCH=false

# Agent executors (Forge=Developer, Sentinel=Reviewer) — dashboard can override
FORGE_EXECUTOR=cursor
SENTINEL_EXECUTOR=cursor
CURSOR_API_KEY=
CURSOR_REPO_PATH=D:\path\to\test
CURSOR_BRIDGE_URL=http://127.0.0.1:9090
CURSOR_BRIDGE_PORT=9090
CURSOR_MODEL=composer-2.5
# Cursor CLI agent (Sentinel review via `agent -p --mode ask`)
CURSOR_CLI_BIN=agent
CURSOR_CLI_TIMEOUT_SECONDS=300
# MR review subprocess timeout (ask+json is usually <120s; agent+workspace can hang for minutes)
CURSOR_CLI_REVIEW_TIMEOUT_SECONDS=120
CURSOR_CLI_OUTPUT_FORMAT=text
CURSOR_CLI_REVIEW_OUTPUT_FORMAT=json
CURSOR_CLI_MODE=ask
# Review: use agent (read-only via prompt). ask mode often returns "I'm in Ask mode" without reviewing the diff.
CURSOR_CLI_REVIEW_MODE=agent
CURSOR_REVIEW_LANGUAGE=en
CURSOR_REVIEW_INCLUDE_SPECS=false
# Diff-only review: keep false — git diff + rules are embedded in the prompt; --workspace makes agent mode slow.
CURSOR_CLI_REVIEW_USE_WORKSPACE=false
# MR review: ephemeral git worktree + sentinel-review skill (requires CURSOR_REPO_PATH)
CURSOR_REVIEW_USE_WORKTREE=true
# Windows: short root avoids "Filename too long" on deep repo paths (default: %LOCALAPPDATA%\af\wt)
# CURSOR_REVIEW_WORKTREE_ROOT=D:\wt
# RTK — compress git diff before review prompt (docs/RTK_REVIEW.md). Off by default.
CURSOR_REVIEW_USE_RTK=false
RTK_BIN=rtk
RTK_TIMEOUT_SECONDS=60
CURSOR_REVIEW_RTK_MAX_CONTEXT_LINES=3
# Optional proxy for Cursor CLI subprocess (forwarded to agent env)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Jira (On-Premise Server / Data Center)
# ---------------------------------------------------------------------------
# Base URL without trailing slash, e.g. https://jira.company.local
JIRA_URL=https://jira.company.local
JIRA_USERNAME=your.username
# Password OR Personal Access Token (PAT) from Jira profile
JIRA_API_TOKEN=your-password-or-pat
JIRA_AUTH_TYPE=pat
# pat  = Personal Access Token via Bearer (recommended for Jira Server/DC PAT)
# basic = email + API token via Basic auth (Atlassian Cloud)
JIRA_PROJECT_KEY=VEN
# Set false for internal/self-signed TLS certificates
JIRA_VERIFY_SSL=false
# Optional: override sub-task type name if auto-detection fails
# JIRA_SUBTASK_ISSUE_TYPE=Sub-task
# Optional: custom field ID for PRD text (e.g. customfield_10100)
# JIRA_PRD_FIELD_ID=customfield_10100

# ---------------------------------------------------------------------------
# GitLab (On-Premise)
# ---------------------------------------------------------------------------
GITLAB_URL=https://gitlab.company.local
# Personal Access Token or Project Access Token with api scope
GITLAB_TOKEN=your-token
# Use numeric ID OR path (path is preferred for readability)
GITLAB_PROJECT_ID=123
# GITLAB_PROJECT_PATH=your-group/your-repo
GITLAB_DEFAULT_BRANCH=dev-oms-v2
GITLAB_FEATURE_SOURCE_BRANCH=main
GITLAB_MR_TARGET_DEV=dev-oms-v2
GITLAB_MR_TARGET_STAGE=stage
GITLAB_MR_TARGET_PRODUCTION=main
GITLAB_VERIFY_SSL=false

# ---------------------------------------------------------------------------
# Mock mode
# ---------------------------------------------------------------------------
# Global mock for all integrations
USE_MOCK_INTEGRATIONS=true
# Override per service (real Jira/GitLab while other services stay mocked)
USE_MOCK_JIRA=false
USE_MOCK_GITLAB=false

# Confluence (On-Premise) - still mocked unless USE_MOCK_INTEGRATIONS=false
CONFLUENCE_URL=https://confluence.company.local
CONFLUENCE_USERNAME=your-user
CONFLUENCE_API_TOKEN=your-token
CONFLUENCE_SPACE_KEY=ENG

# Mattermost
MATTERMOST_URL=https://mattermost.company.local
MATTERMOST_TOKEN=your-token
MATTERMOST_DISASTER_CHANNEL_ID=disaster-channel-id
MATTERMOST_BUGS_CHANNEL_ID=bugs-channel-id
MATTERMOST_DISASTER_CHANNEL_NAME=disaster
MATTERMOST_BUGS_CHANNEL_NAME=bugs
# Shared secret for Disaster/Bugs ingest (header X-Channel-Alert-Token or body token)
CHANNEL_ALERT_WEBHOOK_SECRET=
# Test classification: ollama | cursor_cli  (dashboard save overrides this)
INCIDENT_CLASSIFIER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CLASSIFIER_MODEL=llama3.2:3b
# Incoming webhook for Stage Deploy Request messages
MATTERMOST_DEPLOY_WEBHOOK_URL=https://chat.test.food/hooks/n5j5cbj6jjr6jym4utreujr5da
DEPLOY_MENTION=@ebrahimi.mahrokh
# Optional shared secret for GitLab webhook (X-Gitlab-Token)
GITLAB_WEBHOOK_SECRET=
# Localhost: poll GitLab when webhooks cannot reach this machine (keep webhook for production)
DEPLOY_POLL_ENABLED=true
DEPLOY_POLL_INTERVAL_SECONDS=30
DEPLOY_POLL_MR_LIMIT=20
DEPLOY_POLL_MAX_CREATE_PER_CYCLE=10
DEPLOY_READY_LIST_LIMIT=10
# When true, Deploy Request is posted to Mattermost without dashboard approval
DEPLOY_IS_AUTOMATIC_SEND_MESSAGE=false

# Elasticsearch / Kibana
ELASTICSEARCH_URL=https://elastic.company.local:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-password
ELASTICSEARCH_INDEX_PATTERN=app-logs-*
ELASTICSEARCH_SERVICE_NAME=TEST
ELASTICSEARCH_SERVICE_ENVIRONMENT=Development
Test_SERVICE_NAMES=TEST,test

# Knowledge RAG (ChromaDB - local vector store)
USE_LOCAL_KNOWLEDGE=true
USE_MOCK_KNOWLEDGE=false
KNOWLEDGE_CHROMA_PATH=./data/chroma
EMBEDDING_MODEL=text-embedding-3-small

# Test MySQL metadata sources (use dedicated read-only accounts)
Test_DB_DEV_HOST=mysql-dev.company.local
Test_DB_DEV_PORT=3306
Test_DB_DEV_USER=knowledge_reader
Test_DB_DEV_PASSWORD=
Test_DB_DEV_NAME=Test_db

Test_DB_STAGE_HOST=mysql-stage.company.local
Test_DB_STAGE_PORT=3306
Test_DB_STAGE_USER=knowledge_reader
Test_DB_STAGE_PASSWORD=
Test_DB_STAGE_NAME=Test_db
Test_DB_CONNECT_TIMEOUT_SECONDS=10

# Test architecture specs (local repo scan)
Test_REPO_PATH=C:\Users\jangjoo.ali\source\repos\Test_new\Test
Test_SRC_RELATIVE=src
Test_LEGACY_API_RELATIVE=Test
Test_SPEC_BRANCH=dev-oms-v2
Test_SPECS_STORAGE_PATH=./data/specs

# External knowledge service (only if USE_LOCAL_KNOWLEDGE=false)
# KNOWLEDGE_SERVICE_URL=http://knowledge-service.company.local:8080
# KNOWLEDGE_SERVICE_API_KEY=your-key

# Database (agent runs & HITL)
DATABASE_URL=sqlite+aiosqlite:///./data/agent_framework.db

# ---------------------------------------------------------------------------
# Langfuse LLM tracing (https://langfuse.com)
# View individual traces per agent run; use Langfuse dashboards for cost/latency.
# Cloud: https://cloud.langfuse.com — self-host: https://langfuse.com/docs/deployment/self-host
# ---------------------------------------------------------------------------
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-39b0ed4d-2c24-490a-9801-7ee9eeb9cd6d
LANGFUSE_SECRET_KEY=sk-lf-ceacc471-267f-4487-b3dd-0f9777203c7e
# Cloud default; use http://localhost:3000 for local Langfuse
LANGFUSE_HOST=https://cloud.langfuse.com
